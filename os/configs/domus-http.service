<?xml version="1.0" standalone='no'?><!--*-nxml-*-->
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!--
  Domus OS - Avahi DNS-SD Service Definition
  Advertises HTTP Web UI and Domus Smart Home Appliance on the local network.
-->
<service-group>
  <name replace-wildcards="yes">Domus Smart Home Hub (%h)</name>

  <!-- Standard HTTP Web Service on Port 80 -->
  <service>
    <type>_http._tcp</type>
    <port>80</port>
    <txt-record>path=/</txt-record>
  </service>

  <!-- Domus Appliance Discovery Service -->
  <service>
    <type>_domus._tcp</type>
    <port>80</port>
    <txt-record>version=1.0.0</txt-record>
    <txt-record>model=Raspberry Pi 4 Model B</txt-record>
    <txt-record>arch=aarch64</txt-record>
    <txt-record>api=/api/v1</txt-record>
  </service>
</service-group>
