    <string name="guide_features_count">13 Secciones Documentadas</string>
    <string name="guide_no_results">No se encontraron temas para tu búsqueda</string>
    <string name="guide_quick_tips_desc">Domus está diseñado para ser totalmente autónomo y tolerante a cortes de Internet.</string>
    <string name="guide_quick_tips_title">Consejos Rápidos y Arquitectura</string>
    <string name="guide_search_placeholder">Buscar temas (ej. tarifas, alarma, cámaras, flowchart, zigbee...)</string>
    <string name="guide_sec10_desc">Lista colaborativa en tiempo real para la familia con categorías y recordatorios de tareas.</string>
    <string name="guide_sec10_h1">Sincronización por WebSocket en todos los dispositivos familiares al instante.</string>
    <string name="guide_sec10_h2">Organización por pasillos del supermercado (Frutería, Frescos, Despensa).</string>
    <string name="guide_sec10_h3">Añadido rápido por voz: \'Añade café a la lista de la compra\'.</string>
    <string name="guide_sec10_title">Lista de la Compra Compartida y Tareas</string>
    <string name="guide_sec11_desc">Redundancia de hardware (HA) con IP Virtual Keepalived, replicación WAL y failover en 2s.</string>
    <string name="guide_sec11_h1">Dirección IP virtual compartida (VIP) con toma de control en menos de 2 segundos.</string>
    <string name="guide_sec11_h2">Replicación continua de las transacciones SQLite WAL hacia el nodo secundario.</string>
    <string name="guide_sec11_h3">Panel de supervisión de nodos y botón de promoción manual para mantenimientos.</string>
    <string name="guide_sec11_title">Alta Disponibilidad Failover Dual-Hub</string>
    <string name="guide_sec12_desc">Enlaces de invitación seguros, roles por permisos y copias de seguridad AES-256-GCM.</string>
    <string name="guide_sec12_h1">Roles claros: Administrador (total), Operador (control), Visualizador (solo lectura).</string>
    <string name="guide_sec12_h2">Enlaces de invitación con caducidad para incorporar a familiares en segundos.</string>
    <string name="guide_sec12_h3">Copias de seguridad cifradas con AES-256-GCM y restauración protegida por CLI.</string>
    <string name="guide_sec12_title">Gestión Familiar, Roles RBAC y Copias Cifradas</string>
    <string name="guide_sec13_desc">Gestión de altavoces Apple AirPlay, Google Cast, DLNA y locales. Sincronización de zonas, difusión TTS y base SQLite.</string>
    <string name="guide_sec13_h1">Registro rápido desde la Web GUI (+ Añadir Reproductor), mediante API REST (POST /api/v1/media/players) o consulta directa SQL.</string>
    <string name="guide_sec13_h2">Soporte multi-protocolo nativo para Apple HomePod, Google Nest, receptores AVR DLNA y salidas de audio local de la Raspberry Pi.</string>
    <string name="guide_sec13_h3">Difusión de mensajes de voz prioritarios en toda la casa con Piper TTS pausando temporalmente la música en curso.</string>
    <string name="guide_sec13_title">Audio Multi-Habitación y Registro de Media Players</string>
    <string name="guide_sec1_desc">Operación 100% offline en Raspberry Pi 4 con SQLite WAL, event bus en memoria y sin fuga de datos.</string>
    <string name="guide_sec1_h1">Base de datos SQLite en modo WAL para lecturas concurrentes de máxima velocidad.</string>
    <string name="guide_sec1_h2">Bus de eventos asíncrono en memoria con aislamiento y protección por disyuntores.</string>
    <string name="guide_sec1_h3">Sin dependencias de servidores remotos: todo permanece físicamente en tu hogar.</string>
    <string name="guide_sec1_title">Arquitectura Local y Privacidad Total</string>
    <string name="guide_sec2_desc">Distribución de la vivienda por áreas, control en tiempo real de luces, climatización y sensores.</string>
    <string name="guide_sec2_h1">Actualizaciones en tiempo real por WebSocket sin recargar el navegador.</string>
    <string name="guide_sec2_h2">Soporte para luces, enchufes, termostatos de climatización, sensores y persianas.</string>
    <string name="guide_sec2_h3">Helpers virtuales personalizados (conmutadores, temporizadores, contadores).</string>
    <string name="guide_sec2_title">Panel de Control, Habitaciones y Entidades</string>
    <string name="guide_sec3_desc">Descarga de precios horarios de PUN/Nord Pool/Octopus, gráfica 24h y programación de consumo.</string>
    <string name="guide_sec3_h1">Descarga automática diaria de los precios horarios del mercado eléctrico a las 13:00.</string>
    <string name="guide_sec3_h2">Gráfica interactiva de 24h con código de colores (rojo, naranja, verde).</string>
    <string name="guide_sec3_h3">Programación de cargas flexibles (aerotermia, coche eléctrico) en horas de coste mínimo.</string>
    <string name="guide_sec3_title">Tarifas Dinámicas PUN y Cargas Flexibles</string>
    <string name="guide_sec4_desc">Streaming WebRTC/RTSP, zonas poligonales de movimiento e inferencia local ONNX sin nube.</string>
    <string name="guide_sec4_h1">Flujos de baja latencia WebRTC y RTSP con consumo de procesador muy bajo.</string>
    <string name="guide_sec4_h2">Dibujo libre de zonas de movimiento (Motion Zones) para evitar falsas alarmas.</string>
    <string name="guide_sec4_h3">Notificaciones push inmediatas con clips animados WebP ligeros.</string>
    <string name="guide_sec4_title">Videovigilancia y NVR IA Local</string>
    <string name="guide_sec5_desc">Instalación de Tasmota, WLED, ESPHome en ESP32/ESP8266 por USB con provisión Wi-Fi.</string>
    <string name="guide_sec5_h1">Estándar W3C WebSerial en Chrome y Edge sin necesidad de programas externos.</string>
    <string name="guide_sec5_h2">Catálogo oficial para Tasmota, WLED, ESPHome y dongles Zigbee.</string>
    <string name="guide_sec5_h3">Configuración previa de Wi-Fi antes de flashear para conexión inmediata.</string>
    <string name="guide_sec5_title">Flasheo Firmware USB en Navegador (WebSerial)</string>
    <string name="guide_sec6_desc">Motor de reglas JSON DSL y lienzo SVG para flujos interactivos estilo Node-RED con simulación.</string>
    <string name="guide_sec6_h1">Disparadores basados en cambios de estado, umbrales, horarios y posición solar.</string>
    <string name="guide_sec6_h2">Diseñador visual de diagramas de flujo con curvas de Bézier intuitivas.</string>
    <string name="guide_sec6_h3">Simulador interactivo que traza el flujo de datos sin accionar los relés físicos.</string>
    <string name="guide_sec6_title">Automatizaciones y Diseñador Flowchart</string>
    <string name="guide_sec7_desc">Panel de alarma con 4 modos, código PIN, temporizadores y enlace Zigbee independiente.</string>
    <string name="guide_sec7_h1">Cuatro modos de seguridad: Desarmado, Casa, Noche y Fuera.</string>
    <string name="guide_sec7_h2">Temporizadores de entrada y salida configurables protegidos por PIN numérico.</string>
    <string name="guide_sec7_h3">Zigbee Direct Binding: sensores y sirenas se comunican incluso si el hub se apaga.</string>
    <string name="guide_sec7_route_label">Panel y Alarma</string>
    <string name="guide_sec7_title">Central de Alarma y Enlace Directo Zigbee</string>
    <string name="guide_sec8_desc">Detección local de \'Ehi Domus\', audio seguro por WebSocket y resolución contextual por habitación.</string>
    <string name="guide_sec8_h1">Procesamiento de la palabra clave \'Ehi Domus\' en el satélite sin telemetría.</string>
    <string name="guide_sec8_h2">Contexto espacial: \'Enciende la luz\' actúa sobre la habitación donde te encuentras.</string>
    <string name="guide_sec8_h3">Interruptor físico de privacidad con indicador LED.</string>
    <string name="guide_sec8_title">Asistente de Voz y Satélites Multi-Habitación</string>
    <string name="guide_sec9_desc">Descubrimiento de red local para Shelly, Hue, Tapo, Nanoleaf, Yeelight y Tuya Local.</string>
    <string name="guide_sec9_h1">Escucha pasiva mDNS y SSDP para detectar nuevos dispositivos Wi-Fi.</string>
    <string name="guide_sec9_h2">Emparejamiento en 1 clic sin necesidad de cuentas cloud de fabricantes.</string>
    <string name="guide_sec9_h3">Soporte nativo para coordinadores Zigbee y puentes Philips Hue.</string>
    <string name="guide_sec9_title">Integraciones 1-Clic y Catálogo de Marcas LAN</string>
