    <string name="tour_step1_desc">Domus opera al 100% en tu red local: cero dependencia de nubes externas, privacidad absoluta y consumo mínimo en Raspberry Pi 4.</string>
    <string name="tour_step1_tagline">Tu centro domótico local e independiente</string>
    <string name="tour_step1_title">Bienvenido a Domus 🏠</string>
    <string name="tour_step2_desc">Controla luces, climatización, interruptores y sensores en tiempo real con sincronización inmediata por WebSocket sin recargar la página.</string>
    <string name="tour_step2_tagline">Todos tus dispositivos a un solo clic</string>
    <string name="tour_step2_title">Panel y Control de Entidades 💡</string>
    <string name="tour_step3_desc">Domus descarga los precios horarios diarios y programa automáticamente electrodomésticos de gran consumo (aerotermia, termo, coche eléctrico) en horas baratas.</string>
    <string name="tour_step3_tagline">Ahorra con los precios horarios de PUN y Nord Pool</string>
    <string name="tour_step3_title">Tarifas Dinámicas de Energía ⚡</string>
    <string name="tour_step4_desc">Transmisión WebRTC/RTSP de baja latencia, zonas de movimiento poligonales e inferencia local ONNX para detectar personas, coches y paquetes.</string>
    <string name="tour_step4_tagline">Seguridad visual inteligente sin la nube</string>
    <string name="tour_step4_title">Videovigilancia y NVR IA Local 📹</string>
    <string name="tour_step5_desc">Crea reglas basadas en disparadores y condiciones, o dibuja diagramas de flujo SVG en estilo Node-RED con simulador en tiempo real.</string>
    <string name="tour_step5_tagline">Lógica domótica avanzada e interactiva</string>
    <string name="tour_step5_title">Automatizaciones y Diseñador Flowchart 🔄</string>
    <string name="tour_step6_desc">Cuatro modos de seguridad con código PIN y enlace directo Zigbee para activar sirenas incluso si el hub se está reiniciando.</string>
    <string name="tour_step6_tagline">Protección perimetral y volumétrica de máxima fiabilidad</string>
    <string name="tour_step6_title">Panel de Alarma y Mesh Zigbee 🛡️</string>
    <string name="tour_step7_desc">Distribuye micrófonos satélite: la palabra de activación se procesa localmente y el sistema reconoce de qué habitación procede la orden.</string>
    <string name="tour_step7_tagline">Control por voz en varias habitaciones con contexto</string>
    <string name="tour_step7_title">Satélites de Voz \'Ehi Domus\' 🎙️</string>
    <string name="tour_step8_desc">Enlaza dispositivos Shelly, Hue, Tapo y Sonoff en 1 clic y programa placas ESP32/ESP8266 por USB con WebSerial sin software adicional.</string>
    <string name="tour_step8_tagline">Detección sin nube y flasheo desde el navegador</string>
