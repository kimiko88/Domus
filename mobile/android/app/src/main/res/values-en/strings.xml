    <string name="guide_sec10_desc">Real-time collaborative checklist across family members categorized by grocery aisle with chore reminders.</string>
    <string name="guide_sec10_h1">Live WebSocket synchronization across all family phones and tablets.</string>
    <string name="guide_sec10_h2">Automatic supermarket aisle categorization (Produce, Dairy, Bakery).</string>
    <string name="guide_sec10_h3">Voice quick-add: \'Add coffee to the shopping list\'.</string>
    <string name="guide_sec10_title">Shared Family Shopping List &amp; Chores</string>
    <string name="guide_sec11_desc">High availability (HA) architecture with Keepalived Virtual IP, delta WAL replication, and manual/auto promotion.</string>
    <string name="guide_sec11_h1">Floating Keepalived Virtual IP (VIP) with sub-2s automated failover.</string>
    <string name="guide_sec11_h2">Continuous streaming SQLite WAL delta replication to the standby node.</string>
    <string name="guide_sec11_h3">Node health monitoring dashboard with 1-click promotion for scheduled maintenance.</string>
    <string name="guide_sec11_title">Dual-Hub High Availability Failover</string>
    <string name="guide_sec12_desc">Secure invite links, granular roles (Admin, Operator, Viewer), and AES-256-GCM encrypted backup CLI.</string>
    <string name="guide_sec12_h1">Granular roles: Administrator (full), Operator (control), Viewer (read-only).</string>
    <string name="guide_sec12_h2">Secure time-limited invite links to onboard family members in seconds.</string>
    <string name="guide_sec12_h3">AES-256-GCM encrypted backup archives with path-traversal-safe restore CLI.</string>
    <string name="guide_sec12_title">Family Management, RBAC &amp; Encrypted Backups</string>
    <string name="guide_sec1_desc">100% offline operation on Raspberry Pi 4 with SQLite WAL, in-memory event bus, and zero cloud data leaks.</string>
    <string name="guide_sec1_h1">Embedded SQLite in WAL mode for ultra-fast concurrent queries.</string>
    <string name="guide_sec1_h2">In-memory typed asynchronous event bus with bounded pools and circuit breakers.</string>
    <string name="guide_sec1_h3">Zero external dependencies or subscriptions: everything physically stays in your hub.</string>
    <string name="guide_sec1_title">Local &amp; Privacy-First Architecture</string>
    <string name="guide_sec2_desc">Home organization into rooms and areas, real-time control of lights, switches, climate, and virtual helpers.</string>
    <string name="guide_sec2_h1">Bidirectional live state updates over WebSocket.</string>
    <string name="guide_sec2_h2">Supports lights, switches, climate thermostats, sensors, and covers.</string>
    <string name="guide_sec2_h3">Custom virtual helpers (boolean switches, timers, counters, dropdowns).</string>
    <string name="guide_sec2_title">Dashboard, Rooms and Entities</string>
    <string name="guide_sec3_desc">Automatic ingestion of PUN/Nord Pool/Octopus hourly prices, 24h curve visualization, and load scheduling.</string>
    <string name="guide_sec3_h1">Daily ingestion of PUN (Italian market) and Nord Pool day-ahead prices at 13:00.</string>
    <string name="guide_sec3_h2">Interactive color-coded 24h pricing curve (red, orange, green).</string>
    <string name="guide_sec3_h3">Flexible load scheduling (heat pumps, water heaters, EV chargers) at minimum or negative cost hours.</string>
    <string name="guide_sec3_title">Dynamic PUN Tariffs &amp; Flexible Loads</string>
    <string name="guide_sec4_desc">WebRTC/RTSP video streaming, polygonal motion zones, and local ONNX inference for people, vehicles, and packages.</string>
    <string name="guide_sec4_h1">Low-latency WebRTC and RTSP streams with low CPU overhead on Raspberry Pi.</string>
    <string name="guide_sec4_h2">Custom polygonal motion zones to filter out trees or road traffic.</string>
    <string name="guide_sec4_h3">Instant mobile push notifications with lightweight animated WebP snapshots.</string>
    <string name="guide_sec4_title">CCTV &amp; Local AI NVR</string>
    <string name="guide_sec5_desc">Flash Tasmota, WLED, and ESPHome onto ESP32/ESP8266 boards via USB with automatic Wi-Fi provisioning.</string>
    <string name="guide_sec5_h1">Uses standard W3C WebSerial API in Google Chrome and Edge with zero external tools.</string>
    <string name="guide_sec5_h2">Curated firmware catalog for Tasmota, WLED, ESPHome, and Sonoff Zigbee Dongles.</string>
    <string name="guide_sec5_h3">Pre-flash Wi-Fi provisioning: devices connect to your hub on initial boot.</string>
    <string name="guide_sec5_title">USB Firmware Flashing in Browser (WebSerial)</string>
    <string name="guide_sec6_desc">Declarative JSON DSL rule engine and SVG canvas for designing visual Node-RED style flows with dry-run tests.</string>
    <string name="guide_sec6_h1">Triggers based on states, numerical thresholds, schedules, sun azimuth, and webhooks.</string>
    <string name="guide_sec6_h2">Visual SVG flowchart editor with Bézier curves for intuitive logic inspection.</string>
    <string name="guide_sec6_h3">Interactive dry-run simulator tracing data paths without triggering real relays.</string>
    <string name="guide_sec6_title">Rule Automations &amp; Flowchart Designer</string>
    <string name="guide_sec7_desc">4-state alarm panel with PIN codes, delay timers, and Zigbee direct binding for hub-independent reliability.</string>
    <string name="guide_sec7_h1">Four security modes: Disarmed, Arm Home, Arm Night, and Arm Away.</string>
    <string name="guide_sec7_h2">Customizable entry/exit delay timers protected by numerical PIN.</string>
    <string name="guide_sec7_h3">Zigbee Direct Binding: sensors communicate directly with sirens even when the hub is off.</string>
    <string name="guide_sec7_route_label">Dashboard &amp; Alarm</string>
    <string name="guide_sec7_title">Alarm Control Panel &amp; Zigbee Direct Binding</string>
    <string name="guide_sec8_desc">Local wake-word recognition for \'Ehi Domus\', WebSocket audio streaming, and room-aware spatial resolution.</string>
    <string name="guide_sec8_h1">On-device processing of \'Ehi Domus\' wake-word with zero telemetry.</string>
    <string name="guide_sec8_h2">Contextual resolution: \'Turn on the lights\' automatically targets the room where you speak.</string>
    <string name="guide_sec8_h3">Physical privacy mute switch with visual LED indicator.</string>
    <string name="guide_sec8_title">Voice Assistant &amp; Multi-Room Satellites</string>
    <string name="guide_sec9_desc">Fast LAN discovery for Shelly, Philips Hue, TP-Link Tapo/Kasa, Nanoleaf, Yeelight, and Tuya Local with 1-click pairing.</string>
    <string name="guide_sec9_h1">Passive mDNS, SSDP, and broadcast listeners discover Wi-Fi devices automatically.</string>
    <string name="guide_sec9_h2">1-click pairing with zero vendor cloud credentials required.</string>
    <string name="guide_sec9_h3">Native support for Zigbee coordinator dongles and Philips Hue bridges.</string>
    <string name="guide_sec9_title">1-Click LAN Integrations &amp; Brand Catalog</string>
