    <string name="guide_sec13_title">Multi-Raum-Audio &amp; Media-Player-Verwaltung</string>
    <string name="guide_sec1_desc">100% Offline-Betrieb auf Raspberry Pi 4 mit SQLite WAL, In-Memory Event Bus und ohne Cloud-Übertragung.</string>
    <string name="guide_sec1_h1">Eingebettete SQLite im WAL-Modus für extrem schnelle gleichzeitige Lesezugriffe.</string>
    <string name="guide_sec1_h2">Asynchroner typsicherer Event Bus im Arbeitsspeicher mit Schutzschaltern.</string>
    <string name="guide_sec1_h3">Keine externen Abhängigkeiten oder Abos: Alle Daten bleiben physisch in Ihrem Zuhause.</string>
    <string name="guide_sec1_title">Lokale &amp; Datenschutzorientierte Architektur</string>
    <string name="guide_sec2_desc">Strukturierung der Wohnung in Bereiche und Räume, Echtzeitsteuerung von Licht, Heizung und Sensoren.</string>
    <string name="guide_sec2_h1">Bidirektionale Echtzeitaktualisierungen über WebSocket ohne Neuladen.</string>
    <string name="guide_sec2_h2">Unterstützung für Lampen, Schalter, Klimathermostate, Sensoren und Rollos.</string>
    <string name="guide_sec2_h3">Benutzerdefinierte virtuelle Helfer (Schalter, Timer, Zähler, Auswahllisten).</string>
    <string name="guide_sec2_title">Dashboard, Räume und Entitäten</string>
    <string name="guide_sec3_desc">Automatischer Abruf der PUN/Nord-Pool/Octopus-Preise, 24h-Preiskurve und Lastverschiebung.</string>
    <string name="guide_sec3_h1">Täglicher automatischer Abruf der Day-Ahead-Börsenstrompreise um 13:00 Uhr.</string>
    <string name="guide_sec3_h2">Interaktives 24h-Diagramm mit Farbcodierung (rot, orange, grün).</string>
    <string name="guide_sec3_h3">Automatische Einplanung von Großverbrauchern (Wärmepumpe, Boiler, Wallbox) zu Tiefstpreisen.</string>
    <string name="guide_sec3_title">Dynamische Börsenstromtarife &amp; Flexible Lasten</string>
    <string name="guide_sec4_desc">WebRTC/RTSP-Streaming, polygonale Zonen und lokale ONNX-Erkennung von Personen, Autos und Paketen.</string>
    <string name="guide_sec4_h1">Niedrige Latenz mit WebRTC und RTSP bei geringer CPU-Auslastung auf Raspberry Pi.</string>
    <string name="guide_sec4_h2">Individuell gezeichnete Bewegungszonen zur Vermeidung von Fehlalarmen.</string>
    <string name="guide_sec4_h3">Sofortige Push-Benachrichtigungen mit leichten animierten WebP-Clips.</string>
    <string name="guide_sec4_title">Videoüberwachung &amp; Lokaler KI-NVR</string>
    <string name="guide_sec5_desc">Flashen von Tasmota, WLED, ESPHome auf ESP32/ESP8266 über USB mit automatischer WLAN-Konfiguration.</string>
    <string name="guide_sec5_h1">Nutzung des W3C-WebSerial-Standards in Chrome und Edge ohne Zusatzsoftware.</string>
    <string name="guide_sec5_h2">Offizieller Firmware-Katalog für Tasmota, WLED, ESPHome und Sonoff-Zigbee-Sticks.</string>
    <string name="guide_sec5_h3">WLAN-Vorkonfiguration vor dem Flashen: Gerät verbindet sich sofort beim ersten Start.</string>
    <string name="guide_sec5_title">USB-Firmware-Flashen im Browser (WebSerial)</string>
    <string name="guide_sec6_desc">Deklarative JSON-DSL-Regeln und SVG-Canvas für visuelle Node-RED-Abläufe mit Live-Simulation.</string>
    <string name="guide_sec6_h1">Auslöser basierend auf Zuständen, Schwellenwerten, Zeitplänen, Sonnenstand und Webhooks.</string>
    <string name="guide_sec6_h2">Visueller SVG-Flowchart-Editor mit Bézier-Kurven für sofortige Übersicht.</string>
    <string name="guide_sec6_h3">Interaktiver Dry-Run-Simulator, der Datenpfade anzeigt, ohne echte Relais zu schalten.</string>
    <string name="guide_sec6_title">Regel-Automatisierungen &amp; Flowchart-Designer</string>
    <string name="guide_sec7_desc">Alarmpanel mit 4 Zuständen, PIN-Code, Verzögerungstimern und autonomer Zigbee-Direktbindung.</string>
    <string name="guide_sec7_h1">Vier Sicherheitsmodi: Deaktiviert, Zuhause, Nacht und Abwesend.</string>
    <string name="guide_sec7_h2">Individuelle Eingangs- und Ausgangsverzögerungen mit PIN-Absicherung.</string>
    <string name="guide_sec7_h3">Zigbee-Direktbindung: Sensoren steuern Sirenen auch bei ausgeschaltetem Hub direkt an.</string>
    <string name="guide_sec7_route_label">Dashboard &amp; Alarm</string>
    <string name="guide_sec7_title">Alarmzentrale &amp; Zigbee-Direktbindung</string>
    <string name="guide_sec8_desc">Lokale \'Ehi Domus\'-Erkennung, sicheres WebSocket-Audio und raumbezogene Befehlsausführung.</string>
    <string name="guide_sec8_h1">Lokale Aktivierungsworterkennung auf dem Satelliten ohne externe Datenübertragung.</string>
    <string name="guide_sec8_h2">Raumbezug: \'Schalte das Licht an\' steuert das Licht des Raumes, in dem Sie sprechen.</string>
    <string name="guide_sec8_h3">Physischer Privatsphäre-Stummschalter mit optischer LED-Anzeige.</string>
    <string name="guide_sec8_title">Sprachassistent &amp; Multi-Raum-Satelliten</string>
    <string name="guide_sec9_desc">Schnelle Netzwerkerkennung für Shelly, Philips Hue, TP-Link Tapo, Nanoleaf, Yeelight und Tuya Local.</string>
    <string name="guide_sec9_h1">Passives mDNS- und SSDP-Lauschen zur automatischen Erkennung neuer WLAN-Geräte.</string>
    <string name="guide_sec9_h2">1-Klick-Kopplung ohne Cloud-Konten der Hersteller.</string>
    <string name="guide_sec9_h3">Vollständige Unterstützung für Zigbee-Koordinatoren und Philips Hue Bridges.</string>
