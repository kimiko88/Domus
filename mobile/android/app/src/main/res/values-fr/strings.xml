    <string name="guide_no_results">Aucun sujet trouvé pour votre recherche</string>
    <string name="guide_quick_tips_desc">Domus est conçu pour être entièrement autonome et résister aux coupures d\'Internet.</string>
    <string name="guide_quick_tips_title">Conseils Rapides &amp; Architecture</string>
    <string name="guide_search_placeholder">Rechercher un sujet (ex. tarifs, alarme, caméras, flowchart, zigbee...)</string>
    <string name="guide_sec10_desc">Liste collaborative en temps réel partagée avec tri par rayons et rappels de corvées.</string>
    <string name="guide_sec10_h1">Synchronisation instantanée par WebSocket sur tous les smartphones.</string>
    <string name="guide_sec10_h2">Classement automatique par rayons (Fruits &amp; Légumes, Frais, Épicerie).</string>
    <string name="guide_sec10_h3">Ajout rapide vocal : \'Ajoute du café à la liste de courses\'.</string>
    <string name="guide_sec10_title">Liste de Courses Familiale &amp; Tâches</string>
    <string name="guide_sec11_desc">Redondance matérielle (HA) avec IP Virtuelle Keepalived, réplication WAL et bascule en 2 secondes.</string>
    <string name="guide_sec11_h1">IP virtuelle partagée (VIP) avec bascule automatique instantanée.</string>
    <string name="guide_sec11_h2">Réplication continue des écritures SQLite WAL vers le nœud miroir.</string>
    <string name="guide_sec11_h3">Tableau de bord d\'état des nœuds et promotion manuelle en 1 clic.</string>
    <string name="guide_sec11_title">Haute Disponibilité Failover Dual-Hub</string>
    <string name="guide_sec12_desc">Liens d\'invitation sécurisés, rôles granulaires et sauvegardes chiffrées AES-256-GCM.</string>
    <string name="guide_sec12_h1">Rôles stricts : Administrateur (total), Opérateur (actions), Lecteur (consultation).</string>
    <string name="guide_sec12_h2">Liens d\'invitation avec expiration pour intégrer vos proches rapidement.</string>
    <string name="guide_sec12_h3">Archives chiffrées AES-256-GCM avec restauration sécurisée par CLI.</string>
    <string name="guide_sec12_title">Gestion Famille, Rôles RBAC &amp; Sauvegardes</string>
    <string name="guide_sec13_desc">Gestion d\'enceintes Apple AirPlay, Google Cast, DLNA et locales. Synchronisation des pièces, diffusion TTS et base SQLite.</string>
    <string name="guide_sec13_h1">Enregistrement rapide via interface Web (+ Ajouter Lecteur), API REST (POST /api/v1/media/players) ou requête SQL directe.</string>
    <string name="guide_sec13_h2">Compatibilité protocoles locaux avec Apple HomePod, Google Nest, amplificateurs DLNA et sortie jack/USB Raspberry Pi.</string>
    <string name="guide_sec13_h3">Diffusion vocale d\'annonces prioritaires dans toute la maison avec Piper TTS et coupure temporaire de la musique.</string>
    <string name="guide_sec13_title">Audio Multi-Pièces &amp; Enregistrement Lecteurs</string>
    <string name="guide_sec1_desc">Fonctionnement 100% hors-ligne sur Raspberry Pi 4 avec SQLite WAL et bus d\'événements mémoire.</string>
    <string name="guide_sec1_h1">Base SQLite embarquée en mode WAL pour des lectures parallèles ultra-rapides.</string>
    <string name="guide_sec1_h2">Bus d\'événements asynchrone en mémoire avec isolation et disjoncteurs.</string>
    <string name="guide_sec1_h3">Zéro dépendance extérieure ou abonnement : vos données restent chez vous.</string>
    <string name="guide_sec1_title">Architecture Locale &amp; Confidentialité</string>
    <string name="guide_sec2_desc">Organisation de la maison en zones et pièces, contrôle en direct des lumières, climatiseurs et capteurs.</string>
    <string name="guide_sec2_h1">Mises à jour bidirectionnelles en temps réel par WebSocket.</string>
    <string name="guide_sec2_h2">Prise en charge des lumières, prises, thermostats, capteurs et volets.</string>
    <string name="guide_sec2_h3">Helpers virtuels configurables (interrupteurs, minuteries, compteurs).</string>
    <string name="guide_sec2_title">Tableau de Bord, Pièces et Entités</string>
    <string name="guide_sec3_desc">Récupération automatique des prix horaires PUN/Nord Pool/Octopus et planification intelligente.</string>
    <string name="guide_sec3_h1">Téléchargement quotidien des cours de l\'électricité à 13h00.</string>
    <string name="guide_sec3_h2">Courbe interactive 24h avec code couleur (rouge, orange, vert).</string>
    <string name="guide_sec3_h3">Planification des appareils énergivores aux heures à coût minimal ou négatif.</string>
    <string name="guide_sec3_title">Tarifs Énergétiques Dynamiques &amp; Charges</string>
    <string name="guide_sec4_desc">Streaming WebRTC/RTSP, zones de détection polygonales et IA locale ONNX pour personnes, véhicules et colis.</string>
    <string name="guide_sec4_h1">Flux WebRTC et RTSP à faible latence sans surcharger le Raspberry Pi.</string>
    <string name="guide_sec4_h2">Zones polygonales personnalisées pour éliminer les faux positifs.</string>
    <string name="guide_sec4_h3">Notifications push instantanées avec aperçus animés WebP.</string>
    <string name="guide_sec4_title">Vidéosurveillance &amp; NVR IA Local</string>
    <string name="guide_sec5_desc">Programmation de Tasmota, WLED, ESPHome sur ESP32/ESP8266 par câble USB avec provisioning Wi-Fi.</string>
    <string name="guide_sec5_h1">Standard W3C WebSerial sur Chrome et Edge sans logiciel externe.</string>
    <string name="guide_sec5_h2">Catalogue officiel pour Tasmota, WLED, ESPHome et dongles Zigbee.</string>
    <string name="guide_sec5_h3">Injection des identifiants Wi-Fi avant le flash pour une connexion directe.</string>
    <string name="guide_sec5_title">Flash Firmware USB depuis le Navigateur (WebSerial)</string>
    <string name="guide_sec6_desc">Moteur de règles JSON DSL et canevas SVG pour concevoir des flux interactifs avec simulation.</string>
    <string name="guide_sec6_h1">Déclencheurs sur états, seuils, horaires, position solaire et webhooks.</string>
    <string name="guide_sec6_h2">Éditeur graphique à courbes de Bézier pour visualiser facilement la logique.</string>
    <string name="guide_sec6_h3">Simulateur en direct traçant le flux de données sans actionner les relais.</string>
    <string name="guide_sec6_title">Automatisations &amp; Flowchart Node-RED</string>
    <string name="guide_sec7_desc">Panneau d\'alarme 4 états, code PIN, temporisations et liaison directe Zigbee autonome.</string>
    <string name="guide_sec7_h1">Quatre modes de sécurité : Désarmé, Présent, Nuit, et Absent.</string>
    <string name="guide_sec7_h2">Temporisations d\'entrée et sortie configurables protégées par code PIN.</string>
    <string name="guide_sec7_h3">Liaison directe Zigbee : les sirènes sonnent même si le hub est éteint.</string>
    <string name="guide_sec7_route_label">Tableau de Bord &amp; Alarme</string>
    <string name="guide_sec7_title">Centrale d\'Alarme &amp; Liaison Directe Zigbee</string>
    <string name="guide_sec8_desc">Détection locale du mot-clé \'Ehi Domus\', audio WebSocket et contexte spatial par pièce.</string>
    <string name="guide_sec8_h1">Détection de \'Ehi Domus\' sur le satellite sans aucune télémétrie.</string>
    <string name="guide_sec8_h2">Résolution spatiale : \'Allume la lumière\' agit sur la pièce où vous parlez.</string>
    <string name="guide_sec8_h3">Interrupteur physique avec témoin LED pour couper le micro.</string>
    <string name="guide_sec8_title">Assistant Vocal &amp; Satellites Multi-Pièces</string>
    <string name="guide_sec9_desc">Découverte réseau pour Shelly, Philips Hue, TP-Link Tapo, Nanoleaf, Yeelight et Tuya Local.</string>
    <string name="guide_sec9_h1">Écoute mDNS et SSDP pour détecter immédiatement les nouveaux équipements.</string>
    <string name="guide_sec9_h2">Appairage immédiat en 1 clic sans compte cloud constructeur.</string>
    <string name="guide_sec9_h3">Compatibilité directe avec les coordinateurs Zigbee et ponts Hue.</string>
    <string name="guide_sec9_title">Intégrations 1-Clic &amp; Catalogue Réseau LAN</string>
