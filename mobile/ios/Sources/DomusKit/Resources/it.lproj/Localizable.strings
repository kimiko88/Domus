"tour_step1_desc" = "Domus opera al 100% all'interno della tua rete domestica: nessuna dipendenza da cloud esterni, privacy totale e consumo energetico ridotto su Raspberry Pi 4.";
"tour_step1_tagline" = "Il tuo hub domotico locale e indipendente";
"tour_step1_title" = "Benvenuto in Domus 🏠";
"tour_step2_desc" = "Controlla luci, clima, interruttori e monitora sensori in tempo reale. I dati si aggiornano istantaneamente via WebSocket senza dover ricaricare la pagina.";
"tour_step2_tagline" = "Tutti i tuoi dispositivi a portata di clic";
"tour_step2_title" = "Dashboard & Controllo Entità 💡";
"tour_step3_desc" = "Domus scarica quotidianamente i prezzi orari dell'energia e programma automaticamente elettrodomestici energivori (pompa di calore, boiler, ricarica auto) nelle ore a costo minimo o negativo.";
"tour_step3_tagline" = "Risparmia con i prezzi PUN e Nord Pool";
"tour_step3_title" = "Ottimizzazione Dinamica Tariffe ⚡";
"tour_step4_desc" = "Streaming a bassa latenza WebRTC/RTSP, zone di movimento poligonali e intelligenza artificiale locale ONNX per rilevare persone, veicoli e pacchi con snapshot animati immediati.";
"tour_step4_tagline" = "Sicurezza visiva intelligente senza cloud";
"tour_step4_title" = "Videosorveglianza & AI NVR Locale 📹";
"tour_step5_desc" = "Crea regole basate su trigger, condizioni e azioni, oppure disegna complessi flussi visuali con il designer di flowchart SVG integrato in stile Node-RED con simulazione dry-run.";
"tour_step5_tagline" = "Logica domotica avanzata e visiva";
"tour_step5_title" = "Automazioni & Flowchart Designer 🔄";
"tour_step6_desc" = "Quattro modalità di sicurezza (Casa, Notte, Fuori, Disarmato) con codice PIN e binding diretto Zigbee: i sensori attivano le sirene anche in caso di spegnimento o riavvio dell'hub.";
"tour_step6_tagline" = "Protezione perimetrale e volumetrica robusta";
"tour_step6_title" = "Centrale Allarme & Mesh Zigbee 🛡️";
"tour_step7_desc" = "Posiziona satelliti microfonici nelle stanze: la wake-word 'Ehi Domus' viene elaborata in locale e il comando capisce automaticamente la stanza in cui ti trovi.";
"tour_step7_tagline" = "Assistente vocale sempre attivo e contestuale";
"tour_step7_title" = "Satelliti Vocali 'Ehi Domus' 🎙️";
"tour_step8_desc" = "Rileva e associa dispositivi Shelly, Hue, Tapo, Sonoff con un clic, e flasha schede microcontrollore ESP32/ESP8266 via cavo USB con WebSerial senza software esterni.";
"tour_step8_tagline" = "Associazione LAN immediata e flashing da browser";
"tour_step8_title" = "Integrazioni 1-Click & Flashing USB 🔌";
"tour_step9_desc" = "Puoi riavviare questo tour in qualsiasi momento o consultare la guida dettagliata cliccando su 'Guida & Manuale' nel menu di navigazione o nelle Impostazioni.";
"tour_step9_tagline" = "Sei pronto per vivere la tua casa smart";
"tour_step9_title" = "Tutto Pronto! 🚀";
