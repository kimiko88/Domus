"guide_sec10_desc" = "Checklist condivisa in tempo reale tra tutti i membri della famiglia con suddivisione per reparti e gestione delle faccende periodiche.";
"guide_sec10_h1" = "Aggiornamento in tempo reale su tutti i dispositivi con sincronizzazione WebSocket.";
"guide_sec10_h2" = "Raggruppamento automatico per categorie di spesa (Ortofrutta, Freschi, Cura casa).";
"guide_sec10_h3" = "Aggiunta rapida vocale: 'Aggiungi il caffè alla lista della spesa'.";
"guide_sec10_title" = "Lista Spesa Condivisa & Faccende";
"guide_sec11_desc" = "Architettura ad alta disponibilità (HA) con Virtual IP Keepalived, sincronizzazione delta WAL e promozione manuale o automatica.";
"guide_sec11_h1" = "Indirizzo IP virtuale galleggiante condiviso (VIP) con subentro in meno di 2 secondi.";
"guide_sec11_h2" = "Replicazione continua delle transazioni SQLite WAL verso il nodo follower.";
"guide_sec11_h3" = "Pannello di controllo dello stato nodi e promozione manuale per manutenzioni programmate.";
"guide_sec11_title" = "Ridondanza Hardware Failover Dual-Hub";
"guide_sec12_desc" = "Inviti con link sicuro, suddivisione dei ruoli (Admin, Operator, Viewer) e backup crittografati AES-256-GCM ripristinabili via CLI.";
"guide_sec12_h1" = "Ruoli granulari: Amministratore (completo), Operatore (comandi), Visualizzatore (sola lettura).";
"guide_sec12_h2" = "Link d'invito monouso o a scadenza per invitare coinquilini e familiari con un clic.";
"guide_sec12_h3" = "Backup archiviati in formato cifrato AES-256-GCM protetti da password.";
"guide_sec12_title" = "Famiglia, Ruoli RBAC & Backup Cifrati";
"guide_sec13_desc" = "Gestione di altoparlanti Apple AirPlay, Google Cast, DLNA e locali. Sincronizzazione stanze, diffusione TTS e registrazione nel database SQLite.";
"guide_sec13_h1" = "Registrazione rapida da Web GUI (+ Aggiungi Player), via REST API (POST /api/v1/media/players) o con query SQL diretta nella tabella media_players.";
"guide_sec13_h2" = "Supporto completo multi-protocollo LAN per smart speaker Apple HomePod, Google Nest, ricevitori AVR UPnP/DLNA e altoparlanti locali Raspberry Pi.";
"guide_sec13_h3" = "Diffusione vocale prioritaria istantanea su tutta la casa tramite sintesi neurale Piper TTS con abbassamento temporaneo della musica.";
"guide_sec13_title" = "Audio Multi-Room & Registrazione Media Player";
"guide_sec1_desc" = "Funzionamento al 100% offline su Raspberry Pi 4 con SQLite WAL, in-memory event bus e nessun invio di dati all'esterno.";
"guide_sec1_h1" = "Database SQLite incorporato in modalità WAL per letture simultanee ad altissima velocità.";
"guide_sec1_h2" = "Event bus asincrono tipizzato in memoria con isolamento e circuit breaker.";
"guide_sec1_h3" = "Zero dipendenze esterne o abbonamenti: tutto risiede fisicamente nel tuo hub.";
"guide_sec1_title" = "Architettura Locale & Privacy-First";
"guide_sec2_desc" = "Organizzazione della casa in aree e stanze, controllo in tempo reale di luci, interruttori, clima e helper virtuali.";
"guide_sec2_h1" = "Aggiornamenti in tempo reale bidirezionali tramite WebSocket.";
"guide_sec2_h2" = "Supporto domini: luci con luminosità/colore, interruttori, termostati clima, sensori e cover.";
"guide_sec2_h3" = "Helper virtuali personalizzati (interruttori booleani, timer, contatori, selettori).";
"guide_sec2_title" = "Dashboard, Stanze ed Entità";
"guide_sec3_desc" = "Download automatico dei prezzi orari PUN/Nord Pool/Octopus, visualizzazione curva 24h e schedulazione carichi per massimizzare il risparmio.";
"guide_sec3_h1" = "Ingestion automatica giornaliera dei prezzi orari PUN (mercato italiano) e Nord Pool alle ore 13:00.";
"guide_sec3_h2" = "Grafico interattivo con categorizzazione automatica ore rosse, arancioni e verdi.";
"guide_sec3_h3" = "Pianificazione carichi flessibili (pompa di calore, boiler, ricarica veicolo) alle ore a costo minimo o negativo.";
"guide_sec3_title" = "Tariffe Dinamiche PUN & Carichi Flessibili";
"guide_sec4_desc" = "Streaming WebRTC/RTSP, creazione di zone poligonali di movimento e inferenza ONNX locale per riconoscimento di persone, veicoli e pacchi.";
"guide_sec4_h1" = "Flussi a bassa latenza WebRTC e RTSP senza carico eccessivo sul Raspberry Pi.";
"guide_sec4_h2" = "Disegno libero di zone poligonali di rilevamento (Motion Zones) per escludere falsi positivi.";
"guide_sec4_h3" = "Notifiche push istantanee con clip animate WebP leggere per ogni evento rilevato.";
"guide_sec4_title" = "Videosorveglianza & AI NVR Locale";
"guide_sec5_desc" = "Scrittura di Tasmota, WLED, ESPHome su schede ESP32/ESP8266 via cavo USB con provisioning automatico delle credenziali Wi-Fi.";
"guide_sec5_h1" = "Uso dello standard W3C WebSerial in Google Chrome ed Edge senza installare software esterno.";
"guide_sec5_h2" = "Catalogo firmware ufficiale aggiornato per Tasmota, WLED, ESPHome e Sonoff Zigbee Dongle.";
"guide_sec5_h3" = "Iniezione Wi-Fi prima del flashing: il dispositivo si connette all'hub al primo avvio.";
"guide_sec5_title" = "Flashing Firmware USB dal Browser (WebSerial)";
"guide_sec6_desc" = "Motore a regole dichiarative JSON DSL e canvas SVG per disegnare flussi a nodi in stile Node-RED con simulatore dry-run.";
"guide_sec6_h1" = "Trigger basati su cambi di stato, soglie numeriche, orari, posizione solare e webhook.";
"guide_sec6_h2" = "Designer visuale flowchart a curve di Bézier per visualizzare la logica a colpo d'occhio.";
"guide_sec6_h3" = "Simulatore dry-run interattivo che evidenzia il flusso dei dati senza azionare i relè reali.";
"guide_sec6_title" = "Automazioni a Regole & Flowchart Designer";
"guide_sec7_desc" = "Pannello allarme con 4 stati, codice PIN, timer di ritardo e direct binding Zigbee per collegare sensori e sirene in modo autonomo.";
"guide_sec7_h1" = "Quattro modalità di sicurezza: Disarmato, Casa, Notte e Fuori casa.";
"guide_sec7_h2" = "Timer personalizzati di ritardo uscita ed entrata con protezione tramite PIN numerico.";
"guide_sec7_h3" = "Zigbee Direct Binding: sensori porta/finestra e sirene comunicano anche ad hub spento.";
"guide_sec7_route_label" = "Dashboard & Allarme";
"guide_sec7_title" = "Centrale Allarme & Zigbee Direct Binding";
"guide_sec8_desc" = "Riconoscimento locale della wake-word 'Ehi Domus', streaming audio protetto WebSocket e risoluzione spaziale del comando per stanza.";
"guide_sec8_h1" = "Elaborazione a bordo satellite della parola chiave 'Ehi Domus' con zero telemetria.";
"guide_sec8_h2" = "Risoluzione contestuale: 'Accendi la luce' controlla la luce della stanza dove parli.";
