# Domus iOS Fastfile — Fase 5: CI/CD, Test automatizzati e TestFlight
default_platform(:ios)

platform :ios do
  desc "Esegue tutti i test unitari del package DomusKit e della suite Xcode"
  lane :test do
    # 1. Test Package SPM
    sh("swift test --package-path .. --verbose")

    # 2. Test del progetto Xcode
    run_tests(
      project: "domus/domus.xcodeproj",
      scheme: "domus",
      destination: "platform=iOS Simulator,name=iPhone 16,OS=latest",
      clean: true
    )
  end

  desc "Compila la build per il simulatore (usata in CI pull request)"
  lane :build_simulator do
    xcodebuild(
      project: "domus/domus.xcodeproj",
      scheme: "domus",
      destination: "generic/platform=iOS Simulator",
      clean: true,
      build: true,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Compila e distribuisce la nuova build su Apple TestFlight per i beta tester"
  lane :beta do
    # 1. Configurazione App Store Connect API Key (se configurata)
    api_key = nil
    if ENV["APP_STORE_CONNECT_KEY_ID"] && ENV["APP_STORE_CONNECT_ISSUER_ID"] && (ENV["APP_STORE_CONNECT_KEY_CONTENT"] || ENV["APP_STORE_CONNECT_KEY_PATH"])
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
        key_filepath: ENV["APP_STORE_CONNECT_KEY_PATH"],
        is_key_content_base64: ENV["APP_STORE_CONNECT_KEY_CONTENT_IS_BASE64"] == "true"
      )
    end

    # 2. Incrementa il build number basandosi su variabile CI (BUILD_NUMBER) o commit count
    build_num = ENV["BUILD_NUMBER"] || (number_of_commits rescue Time.now.to_i.to_s)
    increment_build_number(
      xcodeproj: "domus/domus.xcodeproj",
      build_number: build_num
    )

    # 3. Compilazione ed esportazione IPA per App Store / TestFlight
    build_app(
      project: "domus/domus.xcodeproj",
      scheme: "domus",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "domus.ipa"
    )

    # 4. Caricamento su Apple TestFlight
    upload_opts = {
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "Domus Native iOS - Build automatica da CI/CD GitHub Actions"
    }
    upload_opts[:api_key] = api_key if api_key

    upload_to_testflight(upload_opts)
  end
end
