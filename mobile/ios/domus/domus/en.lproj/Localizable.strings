"tour_step1_desc" = "Domus runs 100% on your local home network: zero cloud dependencies, total privacy, and ultra-low power consumption on Raspberry Pi 4.";
"tour_step1_tagline" = "Your independent, local-first smart home hub";
"tour_step1_title" = "Welcome to Domus 🏠";
"tour_step2_desc" = "Control lights, climate, switches, and monitor sensors in real time. Live state updates stream via WebSocket with zero page refreshes.";
"tour_step2_tagline" = "All your devices at your fingertips";
"tour_step2_title" = "Dashboard & Entity Control 💡";
"tour_step3_desc" = "Domus ingests daily hourly energy prices and automatically schedules flexible, heavy loads (heat pump, EV charging, water heaters) at minimum or negative cost hours.";
"tour_step3_tagline" = "Save money with PUN and Nord Pool hourly prices";
"tour_step3_title" = "Dynamic Energy Tariffs ⚡";
"tour_step4_desc" = "Low-latency WebRTC/RTSP streaming, polygonal motion zones, and local ONNX neural inference to detect people, vehicles, and packages with animated snapshots.";
"tour_step4_tagline" = "Smart visual security without the cloud";
"tour_step4_title" = "CCTV & Local AI NVR 📹";
"tour_step5_desc" = "Build rule-based triggers and actions, or design rich visual logic flows on the built-in Node-RED style SVG canvas with real-time dry-run simulations.";
"tour_step5_tagline" = "Advanced visual home automation logic";
"tour_step5_title" = "Automations & Flowchart Designer 🔄";
"tour_step6_desc" = "Four armed modes (Home, Night, Away, Disarmed) with secure PIN protection and Zigbee direct binding that keeps sirens triggerable even during hub reboots.";
"tour_step6_tagline" = "Robust perimeter and volumetric security";
"tour_step6_title" = "Alarm Control Panel & Zigbee Mesh 🛡️";
"tour_step7_desc" = "Place satellite microphones in rooms: wake-word recognition happens locally and commands automatically target the room where the speaker is located.";
"tour_step7_tagline" = "Always-on contextual room-aware voice control";
"tour_step7_title" = "Multi-Room 'Ehi Domus' Voice Satellites 🎙️";
"tour_step8_desc" = "Pair Shelly, Hue, Tapo, and Sonoff devices with 1-click on your LAN, and flash ESP32/ESP8266 microcontrollers directly from your browser via WebSerial.";
"tour_step8_tagline" = "Zero-cloud device discovery and in-browser flashing";
"tour_step8_title" = "1-Click LAN Pairing & USB Flasher 🔌";
