"guide_sec5_h2" = "Curated firmware catalog for Tasmota, WLED, ESPHome, and Sonoff Zigbee Dongles.";
"guide_sec5_h3" = "Pre-flash Wi-Fi provisioning: devices connect to your hub on initial boot.";
"guide_sec5_title" = "USB Firmware Flashing in Browser (WebSerial)";
"guide_sec6_desc" = "Declarative JSON DSL rule engine and SVG canvas for designing visual Node-RED style flows with dry-run tests.";
