"guide_sec3_h2" = "Interactive color-coded 24h pricing curve (red, orange, green).";
"guide_sec3_h3" = "Flexible load scheduling (heat pumps, water heaters, EV chargers) at minimum or negative cost hours.";
"guide_sec3_title" = "Dynamic PUN Tariffs & Flexible Loads";
"guide_sec4_desc" = "WebRTC/RTSP video streaming, polygonal motion zones, and local ONNX inference for people, vehicles, and packages.";
