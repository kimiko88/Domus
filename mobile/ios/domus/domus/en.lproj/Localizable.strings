"guide_sec4_h2" = "Custom polygonal motion zones to filter out trees or road traffic.";
"guide_sec4_h3" = "Instant mobile push notifications with lightweight animated WebP snapshots.";
"guide_sec4_title" = "CCTV & Local AI NVR";
"guide_sec5_desc" = "Flash Tasmota, WLED, and ESPHome onto ESP32/ESP8266 boards via USB with automatic Wi-Fi provisioning.";
