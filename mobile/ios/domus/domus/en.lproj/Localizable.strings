"guide_sec12_title" = "Family Management, RBAC & Encrypted Backups";
"guide_sec1_desc" = "100% offline operation on Raspberry Pi 4 with SQLite WAL, in-memory event bus, and zero cloud data leaks.";
"guide_sec1_h1" = "Embedded SQLite in WAL mode for ultra-fast concurrent queries.";
"guide_sec1_h2" = "In-memory typed asynchronous event bus with bounded pools and circuit breakers.";
"guide_sec1_h3" = "Zero external dependencies or subscriptions: everything physically stays in your hub.";
"guide_sec1_title" = "Local & Privacy-First Architecture";
"guide_sec2_desc" = "Home organization into rooms and areas, real-time control of lights, switches, climate, and virtual helpers.";
"guide_sec2_h1" = "Bidirectional live state updates over WebSocket.";
"guide_sec2_h2" = "Supports lights, switches, climate thermostats, sensors, and covers.";
"guide_sec2_h3" = "Custom virtual helpers (boolean switches, timers, counters, dropdowns).";
"guide_sec2_title" = "Dashboard, Rooms and Entities";
"guide_sec3_desc" = "Automatic ingestion of PUN/Nord Pool/Octopus hourly prices, 24h curve visualization, and load scheduling.";
