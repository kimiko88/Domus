"guide_sec6_h2" = "Visual SVG flowchart editor with Bézier curves for intuitive logic inspection.";
"guide_sec6_h3" = "Interactive dry-run simulator tracing data paths without triggering real relays.";
"guide_sec6_title" = "Rule Automations & Flowchart Designer";
"guide_sec7_desc" = "4-state alarm panel with PIN codes, delay timers, and Zigbee direct binding for hub-independent reliability.";
