"guide_sec10_h3" = "Voice quick-add: 'Add coffee to the shopping list'.";
"guide_sec10_title" = "Shared Family Shopping List & Chores";
"guide_sec11_desc" = "High availability (HA) architecture with Keepalived Virtual IP, delta WAL replication, and manual/auto promotion.";
"guide_sec11_h1" = "Floating Keepalived Virtual IP (VIP) with sub-2s automated failover.";
"guide_sec11_h2" = "Continuous streaming SQLite WAL delta replication to the standby node.";
"guide_sec11_h3" = "Node health monitoring dashboard with 1-click promotion for scheduled maintenance.";
"guide_sec11_title" = "Dual-Hub High Availability Failover";
"guide_sec12_desc" = "Secure invite links, granular roles (Admin, Operator, Viewer), and AES-256-GCM encrypted backup CLI.";
