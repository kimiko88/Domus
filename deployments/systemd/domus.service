[Unit]
Description=Domus Local-First Smart Home Hub
Documentation=https://github.com/domus-hub/domus
After=network.target mosquitto.service
Wants=mosquitto.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=domus
Group=domus
WorkingDirectory=/var/lib/domus
ExecStart=/usr/local/bin/domus -config /etc/domus/domus.toml
# Do not restart configuration failures such as an already occupied TCP port.
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=78
TimeoutStopSec=30s
KillMode=control-group

# Process Environment & Limits
Environment=DOMUS_DATABASE_PATH=/var/lib/domus/domus.db
EnvironmentFile=-@DOMUS_CONFIG_DIR@/domus.env
LimitNOFILE=65536

# Security & Sandboxing
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/domus
ReadOnlyPaths=/etc/domus

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=domus

[Install]
WantedBy=multi-user.target
