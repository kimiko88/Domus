# Copy to .env for Docker Compose, or load it in the environment used by systemd.
# Never commit the real .env: it may contain access tokens and credentials.

# ── Domus HTTP server ──────────────────────────────────────────────────────────
DOMUS_SERVER_HOST=0.0.0.0
DOMUS_SERVER_PORT=8080
DOMUS_SERVER_COOKIE_SECURE=false
DOMUS_SERVER_WEB_DIR=
DOMUS_DATABASE_PATH=./data/domus.db
DOMUS_DATABASE_WAL_MODE=true
DOMUS_LOG_LEVEL=info
DOMUS_LOG_FORMAT=json

# Optional HTTPS listener for trusted LAN clients.
DOMUS_LAN_ENABLED=false
DOMUS_LAN_HOST=0.0.0.0
DOMUS_LAN_PORT=8081
DOMUS_LAN_TLS_CERT_FILE=
DOMUS_LAN_TLS_KEY_FILE=

# ── Authentication / retention ─────────────────────────────────────────────────
# Use Go duration syntax: 2160h = 90 days (not "90d").
DOMUS_AUTH_SESSION_TTL=2160h
DOMUS_AUTH_RATE_LIMIT_LOGIN_PER_MIN=10
DOMUS_RETENTION_STATE_HISTORY_DAYS=30
DOMUS_RETENTION_AUDIT_LOG_DAYS=90
DOMUS_RETENTION_AUTOMATION_RUN_DAYS=30

# ── Home location / presence ───────────────────────────────────────────────────
DOMUS_PRESENCE_HOME_LATITUDE=
DOMUS_PRESENCE_HOME_LONGITUDE=
DOMUS_PRESENCE_GEOFENCE_RADIUS_M=150
DOMUS_PRESENCE_GEOFENCE_ENABLED=false

# ── Local voice engine (Whisper + Piper) ───────────────────────────────────────
# Native Wyoming TCP endpoints (the STT/TTS services must already be installed).
# Whisper STT: commonly 10300; Piper TTS: commonly 10200.
DOMUS_WHISPER_ADDR=127.0.0.1:10300
DOMUS_PIPER_ADDR=127.0.0.1:10200
DOMUS_VOICE_LANGUAGE=it
DOMUS_VOICE_MODEL=it_IT-paola-medium

# Optional HTTP adapter fallback. Leave empty to use Wyoming TCP above.
DOMUS_WHISPER_ENDPOINT=
DOMUS_PIPER_ENDPOINT=

# Optional statically provisioned microphone satellites (room context).
# IDs must match the ID used by the microphone/satellite client.
DOMUS_VOICE_SATELLITES_JSON=[]

# ── Linux microphone satellite executable ──────────────────────────────────────
# These variables are read by cmd/domus-voice-satellite, not by the Domus hub.
DOMUS_VOICE_SATELLITE_ID=sat_kitchen
DOMUS_VOICE_SATELLITE_SERVER_URL=https://raspberrypi.tail38e688.ts.net:8080
DOMUS_VOICE_SATELLITE_TOKEN=
DOMUS_VOICE_SATELLITE_WAKE_ADDR=127.0.0.1:10400
DOMUS_VOICE_SATELLITE_WAKE_WORDS=hey_jarvis
DOMUS_VOICE_SATELLITE_AUDIO_DEVICE=default
DOMUS_VOICE_SATELLITE_SPEAKER_DEVICE=
DOMUS_VOICE_SATELLITE_FRAME_DURATION=100ms
DOMUS_VOICE_SATELLITE_SILENCE_DURATION=1200ms
DOMUS_VOICE_SATELLITE_MAX_COMMAND_DURATION=10s
DOMUS_VOICE_SATELLITE_HTTP_TIMEOUT=30s
DOMUS_VOICE_SATELLITE_RMS_THRESHOLD=0.015

# ── OpenDisplay e-paper integration ────────────────────────────────────────────
# Python companion uses py-opendisplay over Bluetooth LE and optional Wi-Fi LAN.
# The bridge token is a random 32+ byte secret. Keep this endpoint on the LAN only.
DOMUS_OPENDISPLAY_ENABLED=false
DOMUS_OPENDISPLAY_BRIDGE_URL=http://host.docker.internal:10320
DOMUS_OPENDISPLAY_BRIDGE_TOKEN=
DOMUS_OPENDISPLAY_DISCOVERY_INTERVAL=60s
DOMUS_OPENDISPLAY_BLE_SCAN_SECONDS=6
DOMUS_OPENDISPLAY_HTTP_TIMEOUT=45s
DOMUS_OPENDISPLAY_ALLOW_WIFI=true

# These are read by deployments/opendisplay-bridge/server.py.
# Docker Compose passes DOMUS_OPENDISPLAY_BRIDGE_TOKEN through to OPENDISPLAY_BRIDGE_TOKEN.
OPENDISPLAY_BRIDGE_BIND=0.0.0.0
OPENDISPLAY_BRIDGE_PORT=10320
OPENDISPLAY_BRIDGE_BLE_SCAN_SECONDS=6
OPENDISPLAY_BRIDGE_ENABLE_WIFI=true
# Optional JSON map: {"AA:BB:CC:DD:EE:FF":"32-character-hex-key"} for encrypted BLE tags.
OPENDISPLAY_BRIDGE_DEVICE_KEYS_JSON={}

# ── Plugin marketplace / HACS-like catalog ────────────────────────────────────
DOMUS_VERSION=1.0.0-dev
# Repository URLs are configured in the Store UI (admin only).
# Official signing keys are base64-encoded Ed25519 public keys, JSON map: {"key-id":"base64"}.
DOMUS_STORE_TRUSTED_KEYS_JSON={}
DOMUS_STORE_ALLOW_UNTRUSTED_REPOSITORIES=false
DOMUS_STORE_INSTALL_ROOT=./data/marketplace
DOMUS_STORE_MAX_ARTIFACT_BYTES=16777216

# ── Tuya integrations (optional) ───────────────────────────────────────────────
TUYA_CLOUD_CLIENT_ID=
TUYA_CLOUD_CLIENT_SECRET=
TUYA_CLOUD_BASE_URL=https://openapi.tuyaeu.com
TUYA_CLOUD_SCHEMA=
TUYA_OAUTH_APP_CLIENT_ID=
TUYA_OAUTH_APP_CLIENT_SECRET=
TUYA_OAUTH_IDENTIFIER=
TUYA_OAUTH_AUTHORIZE_URL=
TUYA_OAUTH_CALLBACK_URL=
TUYA_OAUTH_BASE_URL=https://openapi.tuyaeu.com

# ── Browser Web Push ───────────────────────────────────────────────────────────
DOMUS_VAPID_PUBLIC_KEY=
DOMUS_VAPID_PRIVATE_KEY=
DOMUS_VAPID_SUBJECT=mailto:admin@example.invalid
